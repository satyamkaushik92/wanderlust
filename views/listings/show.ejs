<% layout("/layouts/boilarplate") %>
<script>
  const mapToken="<%= process.env.MAP_TOKEN %>";
  const coordinates=JSON.parse('<%= JSON.stringify(find.geometry.coordinates) %>');
  const location2='<%= (find.location) %>';
</script>
<body>
     <div class="row">
      <div class="col-8 offset-4">
      <h2><%= find.title %></h2>
      
     <div class="card col-6 offset-0.5 listing-card">
         <img src="<%= find.image.url %>" class="card-img-top show-image" alt="listing_image">
        <div class="card-body">
            <p class="card-text">owned by:<i><%= find.owner.username %></i></p>
            <p class="card-text"><%= find.description %></p>
            <p class="card-text">&#8377;<%= find.price.toLocaleString("en-IN") %>/night</p>
            <p class="card-text"><%= find.location %></p>
            <p class="card-text"></p><%= find.country %></div>
        </div>

     </div>
     
     <br>
  <% if(currUser && find.owner._id.equals(currUser._id)){ %>
    <div class="btns col-6 offset-4 mb-3 d-flex">
            <a href="/listings/<%= find._id %>/edit" 
              class="btn btn-dark edit-btn me-3">Edit</a>

      <form method="POST" action="/listings/<%= find._id %>?_method=DELETE">
            <button class="btn btn-dark">Delete</button>
     </form>
   </div>
    <% } %>
      <br>
     </div>
        <hr>
        
        <div class="col-8 offset-4">
          <% if(currUser){ %>
           <h4>Reviews</h4>
            <form action="/listings/<%= find._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div>
              
                 <div class="col-8 offset-4"></div>
               <fieldset class="starability-slot">
              <!-- <label for ="rating" class="form-label">Rating:</label> -->
                <legend>First rating:</legend>
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                <label for="second-rate1" title="Terrible">1 star</label>
                <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                <label for="second-rate2" title="Not good">2 stars</label>
                <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                <label for="second-rate3" title="Average">3 stars</label>
                <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                <label for="second-rate4" title="Very good">4 stars</label>
                <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                <label for="second-rate5" title="Amazing">5 stars</label>
            </fieldset>
         </div>
                <div class="mb-3 mt-3">
                  <label for="comment" class="form-label">Add a comment:</label>
                <textarea class="form-control" id="comment" name="review[comment]" rows="4" cols="50" required></textarea>
                   <div class="invalid-feedback">
                  please provide a comment.
                </div>  
              </div>
                
                  <button type="submit" class="btn btn-dark ">Submit Review</button>
                
                </div>

        </form>
        <% } %>
        <br>
            
            <% if(find.reviews.length>0){ %>
            <div class="row ">
              <h4 class="offset-0">All Reviews</h4>
            <% for(review of find.reviews){ %>
        <div class="listing-card col-6 offset-0 mb-3">
            <div class="card">
            <h5 class="card-title"><%= review.author?.username %></h5>
            <p class="card-text"><%= review.comment %></p>
            
            <p class="starability-result card-text" data-rating="<%= review.rating %>"</p>
            <form class="mb-2" method="POST" action="/listings/<%= find._id %>/reviews/<%= review._id %>?_method=DELETE">
                
              <button class="btn btn-sm btn-dark">Delete</button>
           </form>
            </div>
        </div>
                
            <%}%>
            </div>
            <% } %>
      </div>
          <div class="col-8 offset-4">
            <h4>where you'll be</h4>
            <div id="map"></div>
           </div>
        
     </div>
     <br>
     <script src="/js/map.js"></script>
</body>