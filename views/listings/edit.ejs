<% layout("/layouts/boilarplate") %>
<body>
     <div class="row mt-3"> 
        <div class="col-8 offset-2"> <br>
      <h3>edit data</h3><br>
    <form method="post" action="/listings/<%= find._id %>?_method=put" novalidate class="needs-validation" enctype="multipart/form-data">
       <div class="mb-3">
          <lavel for="title" class="form-label">Title</lavel>
          <input name="listing[title]" value="<%= find.title %>" class="form-control" required>
          <div class="invalid-feedback">
            Please provide a title.
          </div>
       </div>
       <div class="mb-3">
          <lavel for="description" class="form-label">Description</lavel>
          <input name="listing[description]" value="<%= find.description %>" class="form-control">
            <div class="invalid-feedback">
               Please provide a description.
               </div>
       </div>

       <div class="mb-3">
        original listing image: <br>
        <img src="<%= originalImageUrl || find.image.url %>" class="card-img-top show-image" alt="listing_image">
       </div>
       
       <div class="mb-3">
          <lavel for="image" class="form-label">Image</lavel>
          <input name="listing[image]" class="form-control" type="file">
       </div>
       
       <div class="row">
         <div class="mb-3 col-md-4">
          <lavel for="price" class="form-label">Price</lavel>
          <input name="listing[price]" type="Number" value="<%= find.price %>" class="form-control" required>
          <div class="invalid-feedback">
            Please provide a price.
          </div>
         </div>
         <div class="mb-3 col-md-8">
          <lavel for="country" class="form-label">Country</lavel>
          <input name="listing[country]" value="<%=find.country%>" class="form-control" required>
          <div class="invalid-feedback">
            Please provide a country.
          </div>
         </div>
       </div>
       <div class="mb-3">
          <lavel for="location" class="form-label">Location</lavel>
          <input name="listing[location]" value="<%= find.location %>" class="form-control" type="text" required>
            <div class="invalid-feedback">
               Please provide a location.
               </div>
       </div>
         <button class="btn btn-dark edit-btn">Edit</button>
    </form>
     </div> 
     </div> 
     <br>
</body>
